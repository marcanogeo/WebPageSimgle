---
interface Props {
    title: string;
    description: string;
    icon: string;
}

const {
    title,
    description,
    icon
} = Astro.props;
---

<article
        class="rounded-xl border border-slate-100 bg-white p-8 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
>
    <div
            class="mb-6 flex size-12 items-center justify-center rounded-lg bg-brand/10 text-sm font-semibold text-brand"
    >
        {icon}
    </div>

    <h3
            class="font-display text-xl font-semibold text-primary"
    >
        {title}
    </h3>

    <p
            class="mt-3 text-sm leading-relaxed text-slate-500"
    >
        {description}
    </p>
</article>
