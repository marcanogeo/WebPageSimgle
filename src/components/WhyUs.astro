---
const benefits = [
    {
        number: "01",
        title: "Experiencia comprobada",
        description:
            "Nuestra experiencia nos permite anticipar problemas y tomar decisiones con una base sólida.",
    },
    {
        number: "02",
        title: "Atención personalizada",
        description:
            "Cada negocio es diferente. Diseñamos soluciones específicas, sin recetas genéricas.",
    },
    {
        number: "03",
        title: "Resultados medibles",
        description:
            "Te acompañamos hasta convertir cada objetivo en una mejora real para tu negocio.",
    },
];
---

<section
        id="por-que-elegirnos"
        class="bg-white py-24"
        aria-labelledby="why-us-title"
>
    <div class="mx-auto max-w-6xl px-6">

        <!-- Cabecera de la sección -->
        <div class="mx-auto max-w-2xl text-center">
      <span
              class="text-xs font-medium uppercase tracking-[0.2em] text-brand"
      >
        Por qué elegirnos
      </span>

            <h2
                    id="why-us-title"
                    class="mt-3 font-display text-3xl font-semibold text-primary sm:text-4xl"
            >
                Lo que nos diferencia
            </h2>

            <p
                    class="mt-4 text-lg leading-relaxed text-slate-500"
            >
                Combinamos tecnología, diseño y acompañamiento para crear
                soluciones digitales útiles, sencillas y preparadas para evolucionar.
            </p>
        </div>

        <!-- Ventajas -->
        <div class="mt-16 grid gap-12 md:grid-cols-3">
            {
                benefits.map((benefit) => (
                        <article
                                class="text-center"
                        >
            <span
                    class="mx-auto flex size-12 items-center justify-center rounded-full bg-accent/15 text-sm font-semibold text-accent"
                    aria-hidden="true"
            >
              {benefit.number}
            </span>

                            <h3
                                    class="mt-5 font-display text-xl font-semibold text-primary"
                            >
                                {benefit.title}
                            </h3>

                            <p
                                    class="mt-3 text-sm leading-relaxed text-slate-500"
                            >
                                {benefit.description}
                            </p>
                        </article>
                ))
            }
        </div>

    </div>
</section>
