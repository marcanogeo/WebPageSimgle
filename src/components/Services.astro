---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    icon: "01",
    title: "Diseño y desarrollo web",
    description:
        "Creamos sitios web modernos, rápidos y adaptados a dispositivos móviles.",
  },
  {
    icon: "02",
    title: "Digitalización",
    description:
        "Transformamos procesos manuales en soluciones digitales sencillas y eficientes.",
  },
  {
    icon: "03",
    title: "Soporte tecnológico",
    description:
        "Te acompañamos en el mantenimiento y evolución de tus soluciones digitales.",
  },
];
---

<section
    id="servicios"
    class="bg-slate-50 py-24"
>
  <div
      class="mx-auto max-w-6xl px-6"
  >
    <div class="mx-auto max-w-2xl text-center">
      <span
          class="text-xs font-medium uppercase tracking-[0.2em] text-brand"
      >
        Lo que hacemos
      </span>

      <h2
          class="mt-3 font-display text-3xl font-semibold text-primary sm:text-4xl"
      >
        Nuestros servicios
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-slate-500">
        Soluciones digitales diseñadas para resolver necesidades reales con eficiencia y acompañamiento cercano.
      </p>
    </div>

    <div
        class="mt-16 grid gap-8 md:grid-cols-3"
    >
      {
        services.map((service) => (
            <ServiceCard {...service} />
        ))
      }
    </div>
  </div>
</section>
