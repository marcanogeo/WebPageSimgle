<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-100 bg-white/95 backdrop-blur-sm">
<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
  <a
      href="#inicio"
      class="font-display text-xl font-semibold tracking-tight text-primary"
  >
    Nexo<span class="text-accent">.</span>
  </a>

  <nav
      class="hidden items-center gap-8 md:flex"
      aria-label="Navegación principal"
  >
    <a
        href="#servicios"
        class="text-sm text-slate-500 transition-colors hover:text-slate-900"
    >
      Servicios
    </a>

    <a
        href="#nosotros"
        class="text-sm text-slate-500 transition-colors hover:text-slate-900"
    >
      Nosotros
    </a>

    <a
        href="#contacto"
        class="rounded-lg bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-blue-700"
    >
      Solicitar info
    </a>
  </nav>

  <details class="relative md:hidden">
    <summary
      class="flex size-10 cursor-pointer list-none items-center justify-center rounded-md text-slate-600 marker:content-none hover:text-slate-900"
      aria-label="Abrir menú de navegación"
    >
      <span class="sr-only">Menú</span>
      <span aria-hidden="true" class="text-xl leading-none">☰</span>
    </summary>
    <nav
      aria-label="Navegación móvil"
      class="absolute right-0 top-12 w-56 rounded-xl border border-slate-100 bg-white p-3 shadow-xl"
    >
      <a class="block rounded-lg px-4 py-3 text-sm font-medium hover:bg-surface" href="#servicios">Servicios</a>
      <a class="block rounded-lg px-4 py-3 text-sm font-medium hover:bg-surface" href="#nosotros">Nosotros</a>
      <a class="mt-2 block rounded-lg bg-brand px-4 py-3 text-center text-sm font-semibold text-white" href="#contacto">Solicitar info</a>
    </nav>
  </details>
</div>
</header>
