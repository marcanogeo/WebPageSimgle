---
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Diseñamos y desarrollamos productos digitales a medida, desde la estrategia hasta el lanzamiento.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="description" content={description} />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
</head>
<body>
<a
	href="#contenido"
	class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
>
	Saltar al contenido
</a>
<slot />
</body>
</html>
